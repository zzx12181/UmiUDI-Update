<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>
  
  <log4net>
    <!-- 错误日志配置 -->
    <logger name="LogError">
      <level value="ALL" />
      <appender-ref ref="ErrorFileAppender" />
    </logger>
    
    <!-- 信息日志配置 -->
    <logger name="LogInfo">
      <level value="ALL" />
      <appender-ref ref="InfoFileAppender" />
    </logger>
    
    <!-- 调试日志配置 -->
    <logger name="LogDebug">
      <level value="ALL" />
      <appender-ref ref="DebugFileAppender" />
    </logger>
    
    <!-- 监控日志配置 -->
    <logger name="LogMonitor">
      <level value="ALL" />
      <appender-ref ref="MonitorFileAppender" />
    </logger>
    
    <!-- 错误日志文件输出 -->
    <appender name="ErrorFileAppender" type="log4net.Appender.RollingFileAppender">
      <file type="log4net.Util.PatternString" value="%property{LogPath}/LogError/LogError_" />
      <staticLogFileName value="false" />
      <datePattern value="yyyyMMdd'.txt'" />
      <rollingStyle value="Date" />
      <appendToFile value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
      </layout>
      <encoding value="utf-8" />
    </appender>
    
    <!-- 信息日志文件输出 -->
    <appender name="InfoFileAppender" type="log4net.Appender.RollingFileAppender">
      <file type="log4net.Util.PatternString" value="%property{LogPath}/LogInfo/LogInfo_" />
      <staticLogFileName value="false" />
      <datePattern value="yyyyMMdd'.txt'" />
      <rollingStyle value="Date" />
      <appendToFile value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
      </layout>
      <encoding value="utf-8" />
    </appender>
    
    <!-- 调试日志文件输出 -->
    <appender name="DebugFileAppender" type="log4net.Appender.RollingFileAppender">
      <file type="log4net.Util.PatternString" value="%property{LogPath}/LogDebug/LogDebug_" />
      <staticLogFileName value="false" />
      <datePattern value="yyyyMMdd'.txt'" />
      <rollingStyle value="Date" />
      <appendToFile value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
      </layout>
      <encoding value="utf-8" />
    </appender>
    
    <!-- 监控日志文件输出 -->
    <appender name="MonitorFileAppender" type="log4net.Appender.RollingFileAppender">
      <file type="log4net.Util.PatternString" value="%property{LogPath}/LogMonitor/LogMonitor_" />
      <staticLogFileName value="false" />
      <datePattern value="yyyyMMdd'.txt'" />
      <rollingStyle value="Date" />
      <appendToFile value="true" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
      </layout>
      <encoding value="utf-8" />
    </appender>
  </log4net>
</configuration>
