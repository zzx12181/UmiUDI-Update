<?xml version="1.0" encoding="utf-8" ?>
<configuration>

	<configSections>
		<section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
	</configSections>
	
	<appSettings>
		<add key="updatepath" value="https://github.com/zzx12181/UmiUDI-Enterprise/releases/latest/download/update.json" />
		<add key="LocalCerConnection" value="" />
		<add key="OnlineCerConnection" value="Server=RYQGKEBxoQJrEzucAnLKdg==; Database=QgH4gkMmPiEhjby4Gt5wEQ==; User Id=Q7uKprewjYNtBmsoA2lQUQ==; Password=kCZtgrUL9DiZitd4c3YCgg==;" />
		<add key="CompanyConnectionString" value="" />
		<add key="Origin" value="" />
		<add key="DbType" value="" />
		<add key="AppId" value="" />
		<add key="AppSecret" value="" />
		<add key="TYSHXYDM" value="" />
		<add key="Industry" value="0" />
		<add key="RefEntId" value="" />
		<add key="CSDM" value="" />
		<add key="URLCurrentTime" value="" />
		<add key="URLAccessToken" value="" />
		<add key="username" value="" />
		<add key="password" value="" />
		<add key="isRememberPassword" value="" />
		<add key="Printer" value="" />
		<add key="ScannerType" value="" />
		<add key="ScannerPortName" value="" />
		<add key="ScannerBaudRate" value="" />
		<add key="Camera" value="" />
		<add key="CameraMode" value="" />
		<add key="JetIP" value="" />
		<add key="JetPort" value="" />
		<add key="JetKey" value="" />
		<add key="isAutoPrint" value="" />

		<!--DPI和分辨率适配配置-->
		<add key="EnableAutoDpiAdaptation" value="true" />
		<add key="EnableResolutionAdaptation" value="true" />
		<add key="DefaultWindowWidthRatio" value="0.85" />
		<add key="DefaultWindowHeightRatio" value="0.8" />
		<add key="MinWindowWidth" value="1024" />
		<add key="MinWindowHeight" value="768" />
		<add key="BaseFontSize" value="9" />
		<add key="RememberWindowState" value="true" />

		<!--jindie-->
		<add key="X-KDApi-ServerUrl" value="http://103.39.221.54:10615/k3cloud/"/>
		<add key="X-KDApi-AcctID" value=""/>
		<add key="X-KDApi-UserName" value=""/>
		<add key="X-KDApi-Password" value=""/>
		<add key="X-KDApi-LCID" value=""/>

		<!-- EUDAMED 欧盟合规配置 -->
		<!-- 厂商注册登记号 (SRN) -->
		<add key="SRN" value="CN-MF-000000000" />
		<!-- EUDAMED 接口地址 (Playground 环境) -->
		<add key="EudamedEndpoint" value="https://playground.eudamed.ec.europa.eu/dtx/service/DEVICE" />
		<!-- mTLS 证书 .pfx 文件路径 (建议放在程序根目录的 certificates 文件夹下) -->
		<add key="EudamedCertPath" value="certificates\eudamed_cert.pfx" />
		<!-- 证书解密密码 -->
		<add key="EudamedCertPassword" value="your_password_here" />
		<!-- 药品追溯 (DTC) 码上放心配置 -->
		<!-- 直连模式配置 -->
		<add key="DtcAppKey" value="" />
		<add key="DtcAppSecret" value="" />
		<add key="DtcRefEntId" value="" />
		<add key="DtcEntCode" value="" />
		<add key="DtcEntId" value="" />
		<add key="DtcRefUserId" value="" />
		<!-- 原生直连扩展配置 -->
		<add key="DtcBizNamespace" value="ent" />
		<add key="DtcSessionKey" value="" />
		<add key="DtcRefreshToken" value="" />
		<add key="DtcSimulateMode" value="true" />
		<add key="DtcServerUrl" value="https://gw.api.taobao.com/router/rest" />
		<add key="DtcRedirectUri" value="http://code.wxwzcx.com/callback.php" />
	</appSettings>

	<log4net>
		<!--错误日志-->
		<appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
			<!-- 日志文件存放位置，可以为绝对路径也可以为相对路径 -->
			<file value="Logs\\LogError\\" />
			<!--是否支持分割文件-->
			<appendToFile value="true" />
			<!--日志文件的记录形式-->
			<rollingStyle value="Date" />
			<!-- 日志文件的命名规则 -->
			<datePattern value="yyyy\\yyyyMM\\yyyyMMdd'.txt'" />
			<!-- 当将日期作为日志文件的名字时，必须将staticLogFileName的值设置为false -->
			<staticLogFileName value="false" />
			<!--当日志文件达到MaxFileSize大小，就自动创建备份文件。-->
			<param name="MaxSizeRollBackups" value="100" />
			<!--日志文件的布局格式-->
			<layout type="log4net.Layout.PatternLayout">
				<!--每条日志末尾的文字说明-->
				<!--输出格式-->
				<!--样例：2008-03-26 13:42:32,111 [10] INFO  Log4NetDemo.MainClass [(null)] - info-->
				<conversionPattern value="%newline %n记录时间：%date %n线程ID:[%thread] %n日志级别：  %-5level %n错误描述：%message%newline %n" />
			</layout>
		</appender>

		<!--Info日志-->
		<appender name="InfoAppender" type="log4net.Appender.RollingFileAppender">
			<param name="File" value="Logs\\LogInfo\\" />
			<param name="AppendToFile" value="true" />
			<param name="MaxFileSize" value="10240" />
			<param name="MaxSizeRollBackups" value="100" />
			<param name="StaticLogFileName" value="false" />
			<param name="DatePattern" value="yyyy\\yyyyMM\\yyyyMMdd'.txt'" />
			<param name="RollingStyle" value="Date" />
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%newline %n记录时间：%date %n线程ID:[%thread] %n日志级别：  %-5level %n日志描述：%message%newline %n" />
			</layout>
		</appender>

		<!--监控日志-->
		<appender name="MonitorAppender" type="log4net.Appender.RollingFileAppender">
			<param name="File" value="Logs\\LogMonitor\\" />
			<param name="AppendToFile" value="true" />
			<param name="MaxFileSize" value="10240" />
			<param name="MaxSizeRollBackups" value="100" />
			<param name="StaticLogFileName" value="false" />
			<param name="DatePattern" value="yyyy\\yyyyMM\\yyyyMMdd'.txt'" />
			<param name="RollingStyle" value="Date" />
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%newline %n记录时间：%date %n线程ID:[%thread] %n日志级别：  %-5level %n跟踪描述：%message%newline %n" />
			</layout>
		</appender>

		<!--控制台输出-->
		<appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
			</layout>
		</appender>

		<!--Error日志-->
		<logger name="LogError">
			<level value="ERROR" />
			<appender-ref ref="RollingLogFileAppender" />
		</logger>

		<!--Info日志-->
		<logger name="LogInfo">
			<level value="INFO" />
			<appender-ref ref="InfoAppender" />
		</logger>

		<!--监控日志-->
		<logger name="LogMonitor">
			<level value="Monitor" />
			<appender-ref ref="MonitorAppender" />
		</logger>

		<!--根logger，确保所有日志都能输出-->
		<root>
			<level value="ALL" />
			<appender-ref ref="ConsoleAppender" />
		</root>
	</log4net>
</configuration>
